# 复制为 .env 后填写（勿提交 Git）
GITHUB_TOKEN=
DATABASE_URL=mysql://user:password@localhost:3306/dayangyunjie_dev
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=15d
WECHAT_MOCK_OPENID_PREFIX=mock_openid_

# 居民端微信小程序（填写后启用真实 code2session / 手机号解密；留空则走 mock）
WECHAT_CUSTOMER_APPID=
WECHAT_CUSTOMER_SECRET=

# 本地存储落盘图片的公网可访问地址（本机开发可留空，回退 http://localhost:3000）
# 部署到测试/生产环境时必须设置为公网 IP 或域名，否则上传的图片仅服务器本机可见
# 示例：SERVER_BASE_URL=https://118.195.149.50
SERVER_BASE_URL=
STORAGE_PROVIDER=local
CORS_ORIGIN=
