// 大洋云洁智享平台 — 由 docs/Schema.md v1.1 转译（P1.2）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── 枚举（8）────────────────────────────────────────────

enum OrderStatus {
  PENDING_ASSIGN
  ASSIGNED
  ACCEPTED
  IN_SERVICE
  PENDING_ACCEPTANCE
  PENDING_REVIEW
  REVIEWED
  CANCELLED
}

enum ConsultStatus {
  PENDING
  FOLLOWING_UP
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderSource {
  MINIPROGRAM
  PHONE
  PROXY
}

enum WorkerStatus {
  IDLE
  BUSY
}

enum PhotoType {
  BEFORE
  AFTER
  RECYCLING_SITE
}

enum ComplaintReason {
  POOR_ATTITUDE
  NOT_CLEAN
  NOT_ON_TIME
  ITEM_DAMAGED
  EXTRA_CHARGE
  OTHER
}

enum ComplaintStatus {
  PENDING
  PROCESSING
  COMPLETED
}

// ─── 用户模型（3）────────────────────────────────────────

model Resident {
  id        Int      @id @default(autoincrement())
  openid    String   @unique @db.VarChar(64)
  nickname  String?  @db.VarChar(64)
  name      String?  @db.VarChar(32)
  phone     String?  @db.VarChar(20)
  avatar    String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses        Address[]
  cleaningOrders   CleaningOrder[]
  recyclingOrders  RecyclingOrder[]
  consultOrders    ConsultOrder[]

  @@map("residents")
}

model Worker {
  id           Int          @id @default(autoincrement())
  openid       String       @unique @db.VarChar(64)
  employeeNo   String       @unique @map("employee_no") @db.VarChar(32)
  passwordHash String       @map("password_hash") @db.VarChar(128)
  name         String       @db.VarChar(32)
  phone        String       @db.VarChar(20)
  avatar       String?      @db.VarChar(512)
  status       WorkerStatus @default(IDLE)
  rating       Float        @default(5.0)
  totalOrders  Int          @default(0) @map("total_orders")
  skills       Json
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  cleaningOrders  CleaningOrder[]
  recyclingOrders RecyclingOrder[]
  workPhotos      WorkPhoto[]     @relation("WorkPhotoUploader")

  // skills 为 Json，MySQL 复合索引由业务层过滤；status 索引支撑派单查空闲员工
  @@index([status])
  @@map("workers")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(128)
  passwordHash String   @map("password_hash") @db.VarChar(128)
  name         String   @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// ─── 地址（1）────────────────────────────────────────────

model Address {
  id         Int      @id @default(autoincrement())
  residentId Int      @map("resident_id")
  name       String   @db.VarChar(64)
  phone      String   @db.VarChar(20)
  province   String   @db.VarChar(32)
  city       String   @db.VarChar(32)
  district   String   @db.VarChar(32)
  detail     String   @db.VarChar(256)
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, isDefault])
  @@map("addresses")
}

// ─── 订单模型（3）────────────────────────────────────────

model CleaningOrder {
  id                Int            @id @default(autoincrement())
  orderNo           String         @unique @map("order_no") @db.VarChar(32)
  residentId        Int            @map("resident_id")
  workerId          Int?           @map("worker_id")
  serviceItem       String           @map("service_item") @db.VarChar(64)
  serviceDuration   Int            @default(2) @map("service_duration")
  appointDate       DateTime       @map("appoint_date") @db.Date
  appointTimeSlot   String           @map("appoint_time_slot") @db.VarChar(32)
  addressSnapshot   Json           @map("address_snapshot")
  contactName       String           @map("contact_name") @db.VarChar(32)
  contactPhone      String           @map("contact_phone") @db.VarChar(20)
  remark            String?          @db.VarChar(512)
  source            OrderSource
  isProxyOrder      Boolean          @default(false) @map("is_proxy_order")
  proxyName         String?          @map("proxy_name") @db.VarChar(32)
  proxyPhone        String?          @map("proxy_phone") @db.VarChar(20)
  status            OrderStatus      @default(PENDING_ASSIGN)
  referenceAmount   Decimal?         @map("reference_amount") @db.Decimal(10, 2)
  finalAmount       Decimal?         @map("final_amount") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus    @default(UNPAID) @map("payment_status")
  paidAt            DateTime?        @map("paid_at")
  gpsLat            Float?           @map("gps_lat")
  gpsLng            Float?           @map("gps_lng")
  gpsCheckinAt      DateTime?        @map("gps_checkin_at")
  gpsDistance       Float?           @map("gps_distance")
  gpsRemark         String?          @map("gps_remark") @db.VarChar(256)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  resident   Resident    @relation(fields: [residentId], references: [id])
  worker     Worker?     @relation(fields: [workerId], references: [id])
  workPhotos WorkPhoto[]
  review     Review?
  complaints Complaint[]

  @@index([residentId, status])
  @@index([workerId, status])
  @@index([status, appointDate])
  @@index([appointDate])
  @@map("cleaning_orders")
}

model RecyclingOrder {
  id                Int            @id @default(autoincrement())
  orderNo           String         @unique @map("order_no") @db.VarChar(32)
  residentId        Int            @map("resident_id")
  workerId          Int?           @map("worker_id")
  itemType          String           @map("item_type") @db.VarChar(16)
  estimatedWeight   Float            @default(5) @map("estimated_weight")
  actualWeight      Float?           @map("actual_weight")
  appointDate       DateTime       @map("appoint_date") @db.Date
  appointTimeSlot   String           @map("appoint_time_slot") @db.VarChar(32)
  addressSnapshot   Json           @map("address_snapshot")
  contactName       String           @map("contact_name") @db.VarChar(32)
  contactPhone      String           @map("contact_phone") @db.VarChar(20)
  remark            String?          @db.VarChar(512)
  source            OrderSource
  isProxyOrder      Boolean          @default(false) @map("is_proxy_order")
  proxyName         String?          @map("proxy_name") @db.VarChar(32)
  proxyPhone        String?          @map("proxy_phone") @db.VarChar(20)
  status            OrderStatus      @default(PENDING_ASSIGN)
  referenceAmount   Decimal?         @map("reference_amount") @db.Decimal(10, 2)
  finalAmount       Decimal?         @map("final_amount") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus    @default(UNPAID) @map("payment_status")
  paidAt            DateTime?        @map("paid_at")
  gpsLat            Float?           @map("gps_lat")
  gpsLng            Float?           @map("gps_lng")
  gpsCheckinAt      DateTime?        @map("gps_checkin_at")
  gpsDistance       Float?           @map("gps_distance")
  gpsRemark         String?          @map("gps_remark") @db.VarChar(256)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  resident   Resident    @relation(fields: [residentId], references: [id])
  worker     Worker?     @relation(fields: [workerId], references: [id])
  workPhotos WorkPhoto[]
  review     Review?
  complaints Complaint[]

  @@index([residentId, status])
  @@index([workerId, status])
  @@index([status, appointDate])
  @@index([appointDate])
  @@map("recycling_orders")
}

model ConsultOrder {
  id          Int           @id @default(autoincrement())
  orderNo     String        @unique @map("order_no") @db.VarChar(32)
  residentId  Int?          @map("resident_id")
  serviceType String        @map("service_type") @db.VarChar(32)
  name        String        @db.VarChar(32)
  phone       String        @db.VarChar(20)
  description String        @db.Text
  status      ConsultStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  resident   Resident?   @relation(fields: [residentId], references: [id])
  complaints Complaint[]

  @@index([status])
  @@map("consult_orders")
}

// ─── 业务关联（4）────────────────────────────────────────

model WorkPhoto {
  id               Int       @id @default(autoincrement())
  cleaningOrderId  Int?      @map("cleaning_order_id")
  recyclingOrderId Int?      @map("recycling_order_id")
  orderType        String    @map("order_type") @db.VarChar(16)
  photoType        PhotoType @map("photo_type")
  url              String    @db.VarChar(512)
  uploadedBy       Int       @map("uploaded_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  cleaningOrder  CleaningOrder?  @relation(fields: [cleaningOrderId], references: [id], onDelete: Cascade)
  recyclingOrder RecyclingOrder? @relation(fields: [recyclingOrderId], references: [id], onDelete: Cascade)
  uploader       Worker          @relation("WorkPhotoUploader", fields: [uploadedBy], references: [id])

  @@index([cleaningOrderId])
  @@index([recyclingOrderId])
  @@map("work_photos")
}

model Review {
  id               Int      @id @default(autoincrement())
  cleaningOrderId  Int?     @unique @map("cleaning_order_id")
  recyclingOrderId Int?     @unique @map("recycling_order_id")
  orderType        String   @map("order_type") @db.VarChar(16)
  rating           Int
  tags             Json
  content          String?  @db.Text
  images           Json?
  createdAt        DateTime @default(now()) @map("created_at")

  cleaningOrder  CleaningOrder?  @relation(fields: [cleaningOrderId], references: [id], onDelete: Cascade)
  recyclingOrder RecyclingOrder? @relation(fields: [recyclingOrderId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Complaint {
  id               Int             @id @default(autoincrement())
  cleaningOrderId  Int?            @map("cleaning_order_id")
  recyclingOrderId Int?            @map("recycling_order_id")
  consultOrderId   Int?            @map("consult_order_id")
  orderType        String          @map("order_type") @db.VarChar(16)
  reason           ComplaintReason
  description      String          @db.Text
  evidenceImages   Json?           @map("evidence_images")
  status           ComplaintStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  cleaningOrder  CleaningOrder?  @relation(fields: [cleaningOrderId], references: [id])
  recyclingOrder RecyclingOrder? @relation(fields: [recyclingOrderId], references: [id])
  consultOrder   ConsultOrder?   @relation(fields: [consultOrderId], references: [id])
  followUps      ComplaintFollowUp[]

  @@index([status])
  @@map("complaints")
}

model ComplaintFollowUp {
  id          Int      @id @default(autoincrement())
  complaintId Int      @map("complaint_id")
  handlerName String   @map("handler_name") @db.VarChar(32)
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_follow_ups")
}

// ─── 配置（1）────────────────────────────────────────────

model ServiceCatalog {
  id          Int      @id @default(autoincrement())
  bizType     String   @map("biz_type") @db.VarChar(16)
  serviceItem String   @map("service_item") @db.VarChar(64)
  priceMin    Decimal  @map("price_min") @db.Decimal(10, 2)
  priceMax    Decimal  @map("price_max") @db.Decimal(10, 2)
  priceUnit   String   @map("price_unit") @db.VarChar(32)
  description String?  @db.VarChar(512)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([bizType, isActive])
  @@map("service_catalogs")
}
